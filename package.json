{
  "name": "research-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A web research agent that turns a topic into a sourced report.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/api/index.ts",
    "start:api": "tsx src/api/index.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.frontend.json",
    "build": "tsc --noEmit -p tsconfig.frontend.json && vite build"
  },
  "keywords": [],
